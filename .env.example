# Copy this file to .env and fill it in.

# Admin sign-in. Make the hash with:
#   docker compose run --rm web npm run hash-password
ADMIN_USERNAME=editor
ADMIN_PASSWORD_HASH=

# Keep true whenever the site is served over HTTPS (it should be).
# Set to false ONLY to try the site on http://localhost.
COOKIE_SECURE=true

# Set to true when a reverse proxy sits in front (the bundled Caddy does),
# so login lockouts use the visitor's real address.
TRUST_PROXY=false

# Your domain, used by the optional HTTPS proxy (--profile https).
DOMAIN=news.example.com

# How many published versions to keep for the History tab.
HISTORY_KEEP=60

# ---- Public website (optional, recommended) ----
# Every publish builds the paper as plain files in DATA_DIR/site. To put them online
# for free, create a GitHub repository for the site and connect it to Cloudflare Pages,
# Netlify or GitHub Pages; the newsroom commits each edition there.
# Token: GitHub > Settings > Developer settings > Fine-grained tokens, with access to
# that one repository only and the permission "Contents: Read and write".
GITHUB_REPO=
GITHUB_TOKEN=
# Branch the website files go to. Keep the code on main and the website on its own
# branch (created automatically on the first publish), and point your host at it.
GITHUB_BRANCH=site
# The address readers use, shown as a link in the newsroom.
SITE_URL=
# Name and email on the website commits (optional; otherwise your GitHub account's email).
GITHUB_AUTHOR_NAME=
GITHUB_AUTHOR_EMAIL=
